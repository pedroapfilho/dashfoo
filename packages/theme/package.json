{
  "name": "@dashfoo/theme",
  "version": "0.2.2",
  "description": "Opt-in default skin for the @dashfoo/react headless chrome. Tailwind v4 entry with dashfoo utilities, or prebuilt plain CSS — both over overridable --dashfoo-* design tokens.",
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/dashfoo.git",
    "directory": "packages/theme"
  },
  "files": [
    "dist",
    "src/tailwind.css",
    "src/css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dashfoo.css": "./dist/dashfoo.css",
    "./tailwind.css": "./src/tailwind.css",
    "./tokens.css": "./src/css/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown && pnpm run build:css",
    "build:css": "tailwindcss --input ./build/prebuilt.css --output ./dist/dashfoo.css",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}

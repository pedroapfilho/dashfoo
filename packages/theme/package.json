{
  "name": "@dashfoo/theme",
  "version": "0.0.0",
  "description": "Opt-in default skin for the @dashfoo/react headless chrome. Framework-agnostic plain CSS over overridable --dashfoo-* design tokens.",
  "license": "MIT",
  "author": "Pedro Filho <pedro@filho.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/dashfoo.git",
    "directory": "packages/theme"
  },
  "files": [
    "dist",
    "dashfoo.css",
    "tokens.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dashfoo.css": "./dashfoo.css",
    "./tokens.css": "./tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist",
    "dev": "tsdown --watch",
    "lint": "oxlint src",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@repo/config-vitest": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}

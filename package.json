{
  "name": "dashfoo-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "node scripts/dev.mjs",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint typecheck test build && pnpm lint:launch",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky",
    "test:consumers": "node scripts/launch/consumers.mjs",
    "test:sites": "playwright test --config scripts/launch/playwright.config.ts",
    "lint:launch": "oxlint scripts/launch && pnpm lint:examples",
    "lint:examples": "oxlint --config scripts/launch/examples-lint.config.ts --disable-nested-config examples"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "fallow": "^3.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-config-awesomeness": "^4.5.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.22.4",
    "turbo": "^2.10.12",
    "zod-compiler": "^2.0.3"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}

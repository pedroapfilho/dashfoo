{
  "name": "dashfoo-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint typecheck test build && pnpm lint:launch",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-example-versions.mjs",
    "release": "pnpm build:packages && changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit",
    "prepare": "husky",
    "test:consumers": "node scripts/launch/consumers.mjs",
    "test:sites": "playwright test --config scripts/launch/playwright.config.ts",
    "lint:launch": "oxlint scripts/launch && pnpm lint:examples",
    "lint:examples": "oxlint --config scripts/launch/examples-lint.config.mjs --disable-nested-config examples",
    "check:shadcn": "node .github/ci/check-shadcn.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "^1.65.1",
    "@shadcn/lint": "0.2.5",
    "@types/node": "^26.6.6",
    "fallow": "^3.48.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.94.0",
    "oxlint-config-awesomeness": "^5.1.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "tsdown": "^0.23.7",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "turbo": "^2.11.13",
    "zod-compiler": "^2.0.14"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
